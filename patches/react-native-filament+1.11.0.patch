+void EngineImpl::setACESLegacyColorGrading(double exposureStops) {
+  std::unique_lock lock(_mutex);
+  if (!_view) {
+    throw std::runtime_error("View not initialized");
+  }
+
+  ACESLegacyToneMapper toneMapper;
+  ColorGrading* colorGrading = ColorGrading::Builder()
+                                    .toneMapper(&toneMapper)
+                                    .exposure(static_cast<float>(exposureStops))
+                                    .build(*_engine);
+  auto dispatcher = _rendererDispatcher;
+  auto ownedColorGrading = References<ColorGrading>::adoptEngineRef(
+      _engine, colorGrading, [dispatcher](std::shared_ptr<Engine> engine, ColorGrading* grading) {
+        dispatcher->runAsync([engine, grading]() {
+          Logger::log(TAG, "Destroying color grading...");
+          engine->destroy(grading);
+        });
+      });
+
+  _view->setColorGrading(ownedColorGrading.get());
+  _colorGrading = std::move(ownedColorGrading);
+}
